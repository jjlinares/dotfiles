{{ if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}
#!/bin/sh
set -eu

# Install the tools required to configure third-party apt repositories.
sudo apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y{{ range .packages.apt.prerequisites }} {{ . | quote }}{{ end }}

# kubectl uses Kubernetes' minor-specific official apt repository.
sudo install -d -m 0755 /etc/apt/keyrings
key_file="$(mktemp)"
trap 'rm -f "$key_file"' EXIT HUP INT TERM
curl -fsSL "https://pkgs.k8s.io/core:/stable:/{{ .packages.kubernetes.minor }}/deb/Release.key" -o "$key_file"
sudo gpg --dearmor --yes --output /etc/apt/keyrings/kubernetes-apt-keyring.gpg "$key_file"
sudo chmod 0644 /etc/apt/keyrings/kubernetes-apt-keyring.gpg
printf '%s\n' 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/{{ .packages.kubernetes.minor }}/deb/ /' \
    | sudo tee /etc/apt/sources.list.d/kubernetes.list >/dev/null
sudo chmod 0644 /etc/apt/sources.list.d/kubernetes.list

sudo apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y kubectl{{ range .packages.apt.packages }} {{ . | quote }}{{ end }}
{{ end -}}
