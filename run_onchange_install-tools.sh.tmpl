{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -o pipefail

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.opencode/bin:$PATH"
mkdir -p "$HOME/.local/bin"

# Clone source-based packages without managing their internal files.
{{ range .packages.gitRepositories -}}
repository="$HOME/{{ .destination }}"
if [ ! -f "$repository/{{ .marker }}" ]; then
    [ ! -e "$repository" ] || fail "{{ .name }} destination exists but is not a valid installation: $repository"
    git clone --depth=1 {{ .url | quote }} "$repository" \
        || fail "failed to install {{ .name }}"
fi
{{ end }}

# Install the latest released NVM without allowing its installer to edit dotfiles.
export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    nvm_version="$(
        git ls-remote --tags --refs --sort='version:refname' \
            https://github.com/nvm-sh/nvm.git 'v[0-9]*' \
            | awk -F/ 'END { print $3 }'
    )"
    [ -n "$nvm_version" ] || fail "could not determine latest NVM version"
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$nvm_version/install.sh" \
        | PROFILE=/dev/null NVM_DIR="$NVM_DIR" bash \
        || fail "NVM installation failed"
fi

# NVM does not tolerate errexit while loading.
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh" || fail "could not load NVM"
nvm install --lts || fail "Node LTS installation failed"
nvm alias default 'lts/*' || fail "could not set default Node version"

# Node-based command-line tools live under the NVM-managed LTS installation.
{{ range .packages.npmGlobals -}}
if ! npm list --global --depth=0 {{ . | quote }} >/dev/null 2>&1; then
    npm install --global {{ . | quote }} || fail "failed to install {{ . }}"
fi
{{ end }}

# Bun's installer skips shell edits when its destination is already on PATH.
export BUN_INSTALL="$HOME/.bun"
if [ ! -x "$BUN_INSTALL/bin/bun" ]; then
    curl -fsSL https://bun.sh/install | bash || fail "Bun installation failed"
fi

# pnpm's installer always edits a shell file. Give it a disposable HOME while
# keeping PNPM_HOME at its real destination, then discard the generated file.
export PNPM_HOME="$HOME/.local/share/pnpm"
if [ ! -x "$PNPM_HOME/bin/pnpm" ] && [ ! -x "$PNPM_HOME/pnpm" ]; then
    temporary_home="$(mktemp -d)"
    touch "$temporary_home/.bashrc"
    HOME="$temporary_home" PNPM_HOME="$PNPM_HOME" SHELL=/bin/bash \
        sh -c 'curl -fsSL https://get.pnpm.io/install.sh | sh -' \
        || { rm -rf "$temporary_home"; fail "pnpm installation failed"; }
    rm -rf "$temporary_home"
fi

# Native coding agents. Their destinations are already on PATH, preventing
# installer-written shell configuration.
if [ ! -x "$HOME/.local/bin/claude" ]; then
    curl -fsSL https://claude.ai/install.sh | bash -s -- latest \
        || fail "Claude Code installation failed"
fi

if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
    curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path \
        || fail "OpenCode installation failed"
fi
{{ end -}}
