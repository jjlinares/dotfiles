{
  "window.title": "${rootPath}${separator}${appName}",
  "terminal.integrated.automationProfile.osx": {},
  "github.copilot.nextEditSuggestions.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "git.confirmSync": false,
  "git.autofetch": true,
  "terminal.integrated.initialHint": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.minimap.enabled": false,
  "vs-kubernetes": {
    "vscode-kubernetes.helm-path-linux": "/home/jj/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
    "vscode-kubernetes.minikube-path-linux": "/home/jj/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube",
    "vs-kubernetes.crd-code-completion": "enabled"
  },
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/usr/bin/zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "remote.autoForwardPortsSource": "hybrid",
  "docker.extension.enableComposeLanguageServer": false,
  "explorer.confirmPasteNative": false,
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "workbench.editor.empty.hint": "hidden",
  "terminal.integrated.enableVisualBell": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  "chat.tools.urls.autoApprove": {
    "https://argo-cd.readthedocs.io": true,
    "https://argo-workflows.readthedocs.io": true,
    "https://kubernetes.io": true
  },
  "chat.viewSessions.orientation": "stacked",
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop"
  ],
  "diffEditor.renderSideBySide": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "workbench.editor.useModal": "some",
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editor.background": "#0b0e14",
      "sideBar.background": "#10151a",
      "panel.background": "#10151a",
      "activityBar.background": "#0d1217",
      "activityBarTop.background": "#0d1217",
      "titleBar.activeBackground": "#0d1217",
      "commandCenter.background": "#10151a",
      "commandCenter.border": "#24303a",
      "commandCenter.activeBackground": "#151b22",
      "editorGroupHeader.tabsBackground": "#0d1217",
      "editorGroupHeader.noTabsBackground": "#0d1217",
      "tab.activeBackground": "#10151a",
      "tab.inactiveBackground": "#0d1217",
      "tab.hoverBackground": "#151b22",
      "tab.border": "#24303a",
      "statusBar.background": "#0e1419",
      "sideBarSectionHeader.background": "#151b22",
      "panel.border": "#24303a",
      "sideBar.border": "#24303a"
    }
  },
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.persistentSessionScrollback": 100000,
  "chat.disableAIFeatures": true,
  "terminal.integrated.commandsToSkipShell": [
    "pi-code.newSession"
  ]
}
