#!/usr/bin/env bash
set -euo pipefail

mode="${1:?usage: sunshine-kscreen-mode MODE_ID}"

output="$(
    kscreen-doctor -o \
        | perl -pe 's/\e\[[0-9;]*m//g' \
        | awk '
            /^Output:/ {
                if (output && connected) {
                    print output
                    found = 1
                    exit
                }
                output = $3
                connected = 0
                next
            }
            $1 == "connected" { connected = 1 }
            END {
                if (!found && output && connected) print output
            }
        '
)"

[ -n "$output" ] || {
    printf '%s\n' 'No connected KScreen output found' >&2
    exit 1
}

kscreen-doctor "output.${output}.mode.${mode}"
