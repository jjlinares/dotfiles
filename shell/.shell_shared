# kubectl
alias k="kubectl"
alias kk="kubectl kustomize --enable-helm"
alias kka="kustomize build --enable-helm . | kubectl apply --server-side -f -"
alias kkd="kubectl kustomize --enable-helm | kubectl delete -f -"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Browser-Use
export PATH="$HOME/.browser-use-env/bin:$HOME/.local/bin:$PATH"

# browser remote debugging
chrome-debug() {
    local debug_port=9222
    local bridge_port=9223
    local profile_dir="$HOME/.config/chrome-debug-profile"
    local attempts=0
    local socat_pid

    if ! command -v google-chrome >/dev/null 2>&1; then
        echo "Error: google-chrome not found."
        return 1
    fi

    if ! command -v ss >/dev/null 2>&1; then
        echo "Error: ss not found."
        return 1
    fi

    if ! command -v socat >/dev/null 2>&1; then
        echo "Error: socat not found."
        return 1
    fi

    if ss -tulpn | grep -q ":$debug_port "; then
        echo "Error: port $debug_port is already in use."
        return 1
    fi

    if ss -tulpn | grep -q ":$bridge_port "; then
        echo "Error: port $bridge_port is already in use."
        return 1
    fi

    echo "Starting Chrome with remote debugging bridge..."

    google-chrome \
        --remote-debugging-port="$debug_port" \
        --user-data-dir="$profile_dir" \
        --no-first-run \
        --no-default-browser-check \
        >/dev/null 2>&1 &

    while ! ss -tulpn | grep -q ":$debug_port "; do
        sleep 0.5
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 10 ]; then
            echo "Error: Chrome failed to start."
            return 1
        fi
    done

    socat TCP-LISTEN:$bridge_port,fork,bind=172.17.0.1 TCP:127.0.0.1:$debug_port &
    socat_pid=$!

    echo "Connected."
    echo "Gateway: http://host.docker.internal:$bridge_port"
    echo

    if [ -n "${ZSH_VERSION:-}" ]; then
        read -rsk1 "?Press any key to stop the bridge and close Chrome..."
        echo
    else
        read -r -n 1 -s -p "Press any key to stop the bridge and close Chrome..." _
        echo
    fi

    echo "Shutting down..."
    kill "$socat_pid" 2>/dev/null
    pkill -f "chrome-debug-profile"
    echo "Done."
}

# Load local machine-only environment variables.
[ -f "$HOME/.config/shell/env.local" ] && source "$HOME/.config/shell/env.local"
