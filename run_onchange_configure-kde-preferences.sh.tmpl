{{- $kwriteconfig := lookPath "kwriteconfig6" -}}
#!/bin/sh
set -eu

# Tool presence is rendered into the script so installing KDE later retriggers it.
# kwriteconfig6: {{ if $kwriteconfig }}{{ $kwriteconfig }}{{ else }}unavailable{{ end }}

{{ if $kwriteconfig -}}
write_config() {
    file="$1"
    group="$2"
    key="$3"
    value="$4"
    {{ $kwriteconfig | quote }} --file "$file" --group "$group" --key "$key" "$value"
}

# Global appearance and application behavior.
write_config kdeglobals General BrowserApplication google-chrome.desktop
write_config kdeglobals KDE LookAndFeelPackage org.kde.breezedark.desktop
write_config kdeglobals KDE widgetStyle Oxygen

# File dialog preferences.
write_config kdeglobals "KFileDialog Settings" "Allow Expansion" false
write_config kdeglobals "KFileDialog Settings" "Automatically select filename extension" true
write_config kdeglobals "KFileDialog Settings" "Breadcrumb Navigation" false
write_config kdeglobals "KFileDialog Settings" "Decoration position" 2
write_config kdeglobals "KFileDialog Settings" "Show Full Path" false
write_config kdeglobals "KFileDialog Settings" "Show Inline Previews" true
write_config kdeglobals "KFileDialog Settings" "Show Preview" false
write_config kdeglobals "KFileDialog Settings" "Show Speedbar" true
write_config kdeglobals "KFileDialog Settings" "Show hidden files" true
write_config kdeglobals "KFileDialog Settings" "Sort by" Date
write_config kdeglobals "KFileDialog Settings" "Sort directories first" true
write_config kdeglobals "KFileDialog Settings" "Sort hidden files last" false
write_config kdeglobals "KFileDialog Settings" "Sort reversed" false
write_config kdeglobals "KFileDialog Settings" "Speedbar Width" 140
write_config kdeglobals "KFileDialog Settings" "View Style" DetailTree

# KWin behavior without monitor-, desktop-, or tiling-specific state.
write_config kwinrc Windows FocusStealingPreventionLevel 0
write_config kwinrc Xwayland Scale 1
write_config kwinrc org.kde.kdecoration2 ButtonsOnLeft BFS
write_config kwinrc org.kde.kdecoration2 library org.kde.breeze
write_config kwinrc org.kde.kdecoration2 theme Breeze

# KRunner presentation.
write_config krunnerrc General FreeFloating true

# Spectacle behavior; omit recent paths and window geometry.
write_config spectaclerc Annotations annotationToolType 2
write_config spectaclerc GuiConfig captureMode 0
write_config spectaclerc ImageSave translatedScreenshotsFolder Screenshots
write_config spectaclerc VideoSave translatedScreencastsFolder Screencasts

# Update KWin immediately when a Plasma session is available.
if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
fi
{{ end -}}
