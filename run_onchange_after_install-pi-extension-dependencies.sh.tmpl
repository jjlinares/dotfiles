{{- $root := joinPath .chezmoi.sourceDir "dot_pi/agent/extensions" -}}
{{- $extensions := list "skill-interpolation" "subagents" "web-tools" "zed-terminal-status" -}}
#!/bin/bash
set -euo pipefail

# Re-run when an extension dependency manifest changes.
{{ range $extensions -}}
# {{ . }}/package.json: {{ output "sha256sum" (joinPath $root . "package.json") | trim }}
# {{ . }}/package-lock.json: {{ output "sha256sum" (joinPath $root . "package-lock.json") | trim }}
{{ end }}
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm use default >/dev/null
fi

command -v npm >/dev/null 2>&1 || {
    printf '%s\n' 'error: npm is required to install Pi extension dependencies' >&2
    exit 1
}

extension_root="$HOME/.pi/agent/extensions"
{{ range $extensions -}}
npm ci --prefix "$extension_root/{{ . }}" --omit=peer --legacy-peer-deps
{{ end -}}
