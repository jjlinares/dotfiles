{{- $code := lookPath "code" -}}
{{- $cursor := lookPath "cursor" -}}
{{- $codeInstalled := dict -}}
{{- if $code -}}
  {{- range (output "env" "NODE_NO_WARNINGS=1" $code "--list-extensions" | trim | splitList "\n") -}}
    {{- $id := lower (trim .) -}}
    {{- if ne $id "" -}}
      {{- $_ := set $codeInstalled $id true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $cursorInstalled := dict -}}
{{- if $cursor -}}
  {{- range (output "env" "NODE_NO_WARNINGS=1" $cursor "--list-extensions" | trim | splitList "\n") -}}
    {{- $id := lower (trim .) -}}
    {{- if ne $id "" -}}
      {{- $_ := set $cursorInstalled $id true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $codeTracked := dict -}}
{{- $codeMissing := list -}}
{{- range .editorExtensions.vscode -}}
  {{- $id := lower . -}}
  {{- $_ := set $codeTracked $id true -}}
  {{- if and $code (not (hasKey $codeInstalled $id)) -}}
    {{- $codeMissing = append $codeMissing $id -}}
  {{- end -}}
{{- end -}}
{{- $codeExtra := list -}}
{{- if $code -}}
  {{- range (keys $codeInstalled | sortAlpha) -}}
    {{- if not (hasKey $codeTracked .) -}}
      {{- $codeExtra = append $codeExtra . -}}
      {{- $_ := set $codeTracked . true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $cursorTracked := dict -}}
{{- $cursorMissing := list -}}
{{- range .editorExtensions.cursor -}}
  {{- $id := lower . -}}
  {{- $_ := set $cursorTracked $id true -}}
  {{- if and $cursor (not (hasKey $cursorInstalled $id)) -}}
    {{- $cursorMissing = append $cursorMissing $id -}}
  {{- end -}}
{{- end -}}
{{- $cursorExtra := list -}}
{{- if $cursor -}}
  {{- range (keys $cursorInstalled | sortAlpha) -}}
    {{- if not (hasKey $cursorTracked .) -}}
      {{- $cursorExtra = append $cursorExtra . -}}
      {{- $_ := set $cursorTracked . true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $hasExtras := or (gt (len $codeExtra) 0) (gt (len $cursorExtra) 0) -}}
{{- $hasMissing := or (gt (len $codeMissing) 0) (gt (len $cursorMissing) 0) -}}
{{- if or $hasExtras $hasMissing -}}
#!/bin/sh
set -eu

export NODE_NO_WARNINGS=1
{{ if $hasExtras }}
inventory={{ joinPath .chezmoi.sourceDir ".chezmoidata/editor-extensions.yaml" | quote }}
temporary="$(mktemp "${inventory}.XXXXXX")"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
cat >"$temporary" <<'EOF_INVENTORY'
editorExtensions:
  vscode:
{{- range (keys $codeTracked | sortAlpha) }}
    - {{ . }}
{{- end }}
  cursor:
{{- range (keys $cursorTracked | sortAlpha) }}
    - {{ . }}
{{- end }}
EOF_INVENTORY
chmod 0644 "$temporary"
mv "$temporary" "$inventory"
trap - EXIT HUP INT TERM
{{ range $codeExtra -}}
printf 'Tracking VS Code extension: %s\n' {{ . | quote }}
{{ end -}}
{{ range $cursorExtra -}}
printf 'Tracking Cursor extension: %s\n' {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range $codeMissing -}}
{{ $code | quote }} --install-extension {{ . | quote }}
{{ end -}}
{{ range $cursorMissing -}}
{{ $cursor | quote }} --install-extension {{ . | quote }}
{{ end -}}
{{- end -}}
