{{- $herdr := lookPath "herdr" -}}
{{- if $herdr -}}
#!/bin/sh
set -eu

# Relink when either managed plugin file changes.
# plugin hash: {{ printf "%s\n%s" (includeTemplate "herdr/plugins/vscode-workspace/herdr-plugin.toml" .) (includeTemplate "herdr/plugins/vscode-workspace/open-vscode.sh" .) | sha256sum }}
plugin_dir={{ joinPath .chezmoi.homeDir ".local/share/herdr/plugins/vscode-workspace" | quote }}

{{ $herdr | quote }} plugin link "$plugin_dir" >/dev/null
{{ $herdr | quote }} server reload-config >/dev/null 2>&1 || true
{{- end }}
